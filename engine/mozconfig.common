# Wishy Lite GeckoView: a trimmed build of Firefox 155's GeckoView.
# Every option below was checked to exist in FIREFOX_155_0b5_RELEASE
# (mobile/android/moz.configure, toolkit/moz.configure) unless marked "standard".

ac_add_options --enable-application=mobile/android
ac_add_options --enable-release                 # standard: official-style optimised build
ac_add_options --enable-optimize                # standard
ac_add_options --disable-debug                  # standard
ac_add_options --disable-tests                  # standard
ac_add_options --enable-strip                   # standard
ac_add_options --enable-install-strip           # standard

# GeckoView "Lite": drops optional dependencies such as Glean (telemetry).
ac_add_options --enable-geckoview-lite

# Features a TV browser does not need. Each one removes native code or scripts.
ac_add_options --disable-webrtc                 # no video calls; also removes the WebRTC local-IP leak
ac_add_options --disable-crashreporter          # standard: no crash upload code
ac_add_options --disable-updater                # standard
ac_add_options --disable-printing
ac_add_options --disable-webspeech
ac_add_options --disable-jxl                    # JPEG XL images (rare on the web)
ac_add_options --enable-minify=properties
ac_add_options --enable-minify-pdfjs

# Deliberately KEPT (do not disable): --enable-accessibility (screen readers on TV),
# JIT, HTTPS-only, DoH, tracking protection, WebExtensions (uBlock Origin).
# Fonts are already excluded by default (MOZ_ANDROID_EXCLUDE_FONTS=True).
# Google Play Services stays out via the app's Gradle exclude.
