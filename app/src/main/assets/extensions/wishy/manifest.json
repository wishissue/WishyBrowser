{
  "manifest_version": 2,
  "name": "Wishy Core",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "core@wishy.org"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["spatial-nav.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
