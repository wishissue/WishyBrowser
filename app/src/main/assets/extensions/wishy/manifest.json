{
  "manifest_version": 2,
  "name": "Wishy Core",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "core@wishy.org"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "spatial-nav.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ads.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}