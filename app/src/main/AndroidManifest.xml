<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only what's strictly needed to browse, plus the two device
         permissions a page can legitimately ask for through a permission
         prompt (camera/mic for a video-call or ID-verification site, file
         access for uploads). No location, no accounts, no
         analytics/crash-reporting permissions. Each of these is still only
         ever requested from the user at the moment a site asks for it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- required="false": declaring this as required=true would make the
         Play Store filter the app OUT of devices that don't explicitly
         report the leanback feature — which includes Amazon Fire TV and
         a number of generic/off-brand Android TV boxes. We still target
         TV UX (banner, LEANBACK_LAUNCHER, remote input) without excluding
         those devices from finding/installing the app at all. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <!-- Most Android TVs have no camera or microphone at all. Requesting
         the CAMERA/RECORD_AUDIO permissions above would otherwise make
         Google Play silently add these as *required* features and filter
         the app out of exactly the devices this browser targets, so they
         are declared explicitly as optional. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".BrowserApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.WishyBrowser"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:theme="@style/Theme.WishyBrowser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Android TV home screen launcher category -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Many cheap TV boxes, projectors and Android TV variants use a
                 normal (non-Leanback) launcher. Without this filter the app
                 installs fine but never shows up in their app list. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets the OS offer Wishy Browser as a handler for plain web
                 links tapped in other apps, and (on devices that support it)
                 as a choice for "default browser". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
