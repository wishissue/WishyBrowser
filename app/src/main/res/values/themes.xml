<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain framework theme: no AppCompat / Material Components needed. Compose draws everything. -->
    <style name="Theme.WishyBrowser" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/window_bg</item>
    </style>
</resources>
