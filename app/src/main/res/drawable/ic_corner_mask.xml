<?xml version="1.0" encoding="utf-8"?>
<!-- Fills the area outside a 20dp quarter circle: rounds the page corners.
     Same color as the window background. Rotate for the other corners. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp" android:height="20dp"
    android:viewportWidth="20" android:viewportHeight="20">
    <path android:fillColor="@color/background"
        android:pathData="M0,0 L20,0 A20,20 0 0 0 0,20 Z" />
</vector>
